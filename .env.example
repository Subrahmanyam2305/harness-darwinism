# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/harness_darwinism?retryWrites=true&w=majority
DB_NAME=harness_darwinism

# AWS Bedrock (get temporary creds from your AWS SSO / IAM)
AWS_ACCESS_KEY_ID=ASIA...
AWS_SECRET_ACCESS_KEY=...
AWS_SESSION_TOKEN=...
AWS_DEFAULT_REGION=us-east-1

# Models (Bedrock inference profile IDs)
AGENT_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
META_MODEL=us.anthropic.claude-opus-4-6-v1

# Evolution policy
ELITE_RATIO=0.3
MUTATION_RATE=0.4
