# LLM provider
OPENAI_API_KEY=sk-...
# Or use Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/harness_darwinism?retryWrites=true&w=majority

# Evolution settings
AGENT_MODEL=gpt-4o-mini
META_MODEL=gpt-4o
MAX_GENERATIONS=10
POPULATION_SIZE=10
SEEDS_PER_GEN=5
MAX_STEPS_PER_EPISODE=200
